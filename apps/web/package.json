{
  "name": "@verikora/web",
  "version": "0.1.0",
  "private": true,
  "description": "Verikora's web app and BFF: the public page, sign-in, the library, the document page, search and the administration — every analysis an Sovkora run.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 21 && krizaka-server-client-boundary && krizaka-ratchet && krizaka-known-violations check app components lib proxy.ts instrumentation.ts instrumentation-node.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa-accounts": "node scripts/qa-accounts.mjs",
    "db:rebuild": "esbuild scripts/db-rebuild.mts --bundle --platform=node --format=esm '--external:@krizaka/*' --external:pg --external:zod '--external:date-fns*' '--external:@date-fns/*' --log-level=warning --outfile=node_modules/.cache/db-rebuild.mjs && node node_modules/.cache/db-rebuild.mjs"
  },
  "dependencies": {
    "@krizaka/api-keys": "0.3.0",
    "@krizaka/app-config": "^0.2.2",
    "@krizaka/audit": "0.1.3",
    "@krizaka/auth": "^0.14.0",
    "@krizaka/brief": "^0.1.0",
    "@krizaka/charts": "1.0.0",
    "@krizaka/coupons": "0.1.1",
    "@krizaka/credits": "0.1.1",
    "@krizaka/db": "0.3.0",
    "@krizaka/email": "^1.2.0",
    "@krizaka/fonts": "0.5.4",
    "@krizaka/i18n": "^0.2.7",
    "@krizaka/icons": "^0.10.0",
    "@krizaka/intl": "^0.4.1",
    "@krizaka/org": "^1.0.0",
    "@krizaka/organize": "0.5.0",
    "@krizaka/payments": "0.5.0",
    "@krizaka/privacy": "0.2.0",
    "@krizaka/query": "^0.3.0",
    "@krizaka/rate-limit": "0.1.0",
    "@krizaka/settings": "0.7.0",
    "@krizaka/sovkora-client": "^1.0.0",
    "@krizaka/storage": "0.8.0",
    "@krizaka/tailwind": "^4.5.0",
    "@krizaka/time": "0.1.0",
    "@krizaka/tokens": "^4.5.0",
    "@krizaka/ui": "^4.5.0",
    "@krizaka/webhooks": "0.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@verikora/core": "workspace:*",
    "date-fns": "^4.4.0",
    "exif-reader": "^2.0.3",
    "heic-decode": "^2.1.0",
    "next": "^16.4.1",
    "opendal": "0.49.13",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@krizaka/config": "^0.24.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "jsdom": "30.1.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
