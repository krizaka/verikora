{
  "expo": {
    "name": "Verikora",
    "slug": "verikora",
    "scheme": "verikora",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.krizaka.verikora",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:www.verikora.com", "applinks:dev.verikora.com"]
    },
    "android": {
      "package": "com.krizaka.verikora",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.verikora.com"
            },
            {
              "scheme": "https",
              "host": "dev.verikora.com"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#3b36b3"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Verikora scanne vos documents avec l'appareil photo.",
          "photosPermission": "Verikora lit la photo d'un document que vous choisissez."
        }
      ],
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "42d4e9ba-c487-49d6-ab0e-1b821ee9d3cf"
      }
    },
    "owner": "oussamaabid",
    "icon": "./assets/icon.png"
  }
}
